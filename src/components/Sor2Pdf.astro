---
import "../styles/Sor2Pdf.css";
---

<form id="entryform">
  <label for="sor-file">SOR file</label>
  <input type="file" id="sor-file" name="sor-file" accept=".sor" />
  <input
    type="button"
    id="convert-button"
    name="convert-button"
    value="Convert"
  />
</form>

<p id="error-message" hidden></p>

<div id="results" hidden>
  <h1 id="output-title">OTDR Report</h1>

  <section id="section-generalInformation" class="section-report">
    <h2>General information</h2>
    <table class="field-table">
      <tbody>
        <tr>
          <td class="field-label">Filename</td>
          <td id="output-filename" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Date/time of test</td>
          <td id="output-datetime" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Language</td>
          <td id="output-language" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Cable ID</td>
          <td id="output-cableID" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Fiber ID</td>
          <td id="output-fiberID" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Fiber type</td>
          <td id="output-fiberType" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Nominal wavelength (nm)</td>
          <td id="output-wavelengthNominal_nm" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Comments</td>
          <td id="output-comments" class="field-value"></td>
        </tr>
      </tbody>
    </table>
  </section>
  <section id="section-results" class="section-report">
    <h2>Results</h2>
    <table class="field-table">
      <tbody>
        <tr>
          <td class="field-label">Span length (m)</td>
          <td id="output-spanLength_km" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Span loss (dB)</td>
          <td id="output-spanLoss_dB" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Span ORL (dB)</td>
          <td id="output-spanORL_dB" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Average loss (dB/km)</td>
          <td id="output-averageLoss_dbPerkm" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Average splice loss (dB)</td>
          <td id="output-averageSpliceLoss_dB" class="field-value"></td>
        </tr>
        <tr>
          <td class="field-label">Maximum splice loss (dB)</td>
          <td id="output-maxSpliceLoss_dB" class="field-value"></td>
        </tr>
      </tbody>
    </table>
  </section>
  <div style="width: 800px;">
    <canvas id="output-graph"></canvas>
  </div>
</div>

<script>
  import { SorReader } from "../lib/otdr/sor-reader";
  import { createChart } from "../lib/convert";
  import type { GenParamsTranslated } from "../lib/otdr/sor/blocks";
  import type { Chart } from "chart.js";

  const resultsEl = document.getElementById("results") as HTMLElement;
  const errorEl = document.getElementById("error-message") as HTMLElement;
  const canvasEl = document.getElementById("output-graph") as HTMLCanvasElement;
  const inputFormEl = document.getElementById("entryform") as HTMLFormElement;
  let chart: Chart<"line", [number, number][]> | undefined;

  document
    .getElementById("convert-button")
    ?.addEventListener("click", async () => {
      const fileSelector = document.getElementById(
        "sor-file",
      ) as HTMLInputElement;
      const selectedFile: File | null =
        fileSelector.files !== null ? fileSelector.files[0] : null;
      if (selectedFile === null) throw Error("No file selected!");

      errorEl.hidden = true;
      resultsEl.hidden = true;

      chart?.destroy();

      try {
        const fileContents = await selectedFile.arrayBuffer();
        const reader = new SorReader(fileContents);
        reader.parse();

        setResults(reader);

        const filenameEl = document.getElementById("output-filename");
        if (filenameEl !== null && filenameEl.textContent !== null)
          filenameEl.textContent = selectedFile.name;

        chart = createChart(canvasEl, reader);

        resultsEl.hidden = false;

        // inputFormEl.hidden = true;
      } catch (err) {
        errorEl.textContent =
          err instanceof Error ? err.message : "Failed to parse SOR file.";
        errorEl.hidden = false;
      }
    });

  function getFieldAsString(value: any): string {
    let val = "";
    if (value === null) {
      val = "<empty>";
    } else if (typeof value === "string" && value.trim() === "") {
      val = "<empty>";
    } else if (typeof val === "number") {
      val = value.toString();
    } else if (value instanceof Date) {
      val = value.toUTCString();
    } else {
      val = value;
    }

    return val;
  }

  function setResults(sorReader: SorReader) {
    const generalInformationMap = new Map(
      Object.entries(sorReader.results().generalInformation),
    );
    for (const [k, v] of generalInformationMap) {
      const elem = document.getElementById(`output-${k}`) as HTMLElement;
      const val = getFieldAsString(v);

      if (elem !== null && elem.textContent !== null && val)
        elem.textContent = val;
    }

    const resultsMap = new Map(Object.entries(sorReader.results().results));
    for (const [key, val] of resultsMap) {
      const tblRowElem = document.createElement("tr");

      const str = getFieldAsString(val);

      const elem = document.getElementById(`output-${key}`) as HTMLElement;
      elem.textContent = str;
    }
  }
</script>

<style>
  .field-table {
    border-collapse: collapse;
  }

  .field-table td {
    border: none;
    padding: 0.15rem 0.75rem;
  }

  .field-label {
    text-align: left;
    font-weight: 600;
  }

  .field-value {
    text-align: left;
  }
</style>
